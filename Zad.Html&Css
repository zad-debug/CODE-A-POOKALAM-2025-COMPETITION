<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onam Pookalam</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1 class="title">Happy Onam!</h1>
        <div class="pookalam-container">
            
            <div class="pookalam">
                
                <div class="ring ring-outer"></div>

                
                <div class="ring ring-second">
                    <div class="flower flowerOrange" style="--rotation: 0deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 45deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 90deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 135deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 180deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 225deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 270deg;"></div>
                    <div class="flower flowerOrange" style="--rotation: 315deg;"></div>
                </div>

                
                <div class="ring ring-third">
                    <div class="petal-pattern yellow-petals">
                        
                        <div class="petal" style="--angle: 0deg;"></div>
                        <div class="petal" style="--angle: 30deg;"></div>
                        <div class="petal" style="--angle: 60deg;"></div>
                        <div class="petal" style="--angle: 90deg;"></div>
                        <div class="petal" style="--angle: 120deg;"></div>
                        <div class="petal" style="--angle: 150deg;"></div>
                        <div class="petal" style="--angle: 180deg;"></div>
                        <div class="petal" style="--angle: 210deg;"></div>
                        <div class="petal" style="--angle: 240deg;"></div>
                        <div class="petal" style="--angle: 270deg;"></div>
                        <div class="petal" style="--angle: 300deg;"></div>
                        <div class="petal" style="--angle: 330deg;"></div>
                    </div>
                </div>

            
                <div class="ring ring-fourth">
                    <div class="jasmine-pattern">
                        <div class="jasmine" style="--rotation: 0deg;"></div>
                        <div class="jasmine" style="--rotation: 60deg;"></div>
                        <div class="jasmine" style="--rotation: 120deg;"></div>
                        <div class="jasmine" style="--rotation: 180deg;"></div>
                        <div class="jasmine" style="--rotation: 240deg;"></div>
                        <div class="jasmine" style="--rotation: 300deg;"></div>
                    </div>
                </div>

                
                <div class="center-lotus">
                    <div class="lotus-petals">
                        <div class="lotus-petal" style="--rotation: 0deg;"></div>
                        <div class="lotus-petal" style="--rotation: 72deg;"></div>
                        <div class="lotus-petal" style="--rotation: 144deg;"></div>
                        <div class="lotus-petal" style="--rotation: 216deg;"></div>
                        <div class="lotus-petal" style="--rotation: 288deg;"></div>
                    </div>
                    <div class="lotus-center"></div>
                </div>
            </div>
        </div>

        
        <div class="decorations">
            <div class="oil-lamp lamp-left"></div>
            <div class="oil-lamp lamp-right"></div>
        </div>

        <p class="blessing">May King Mahabali bless you with happiness and prosperity!</p>
    </div>

    
</body>
</html>



                            CSS code

body {
    background: linear-gradient(135deg, #ffeaa7, #fab1a0, #fd79a8);
    min-height: 100vh;
    font-family: 'Georgia', serif;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
}

.container {
    text-align: center;
    padding: 20px;
    max-width: 800px;
    width: 100%;
}

.title {
    color: #8B4513;
    font-size: 3rem;
    margin-bottom: 30px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    animation: titleGlow 2s ease-in-out infinite alternate;
}

@keyframes titleGlow {
    from { text-shadow: 2px 2px 4px rgba(0,0,0,0.3); }
    to { text-shadow: 2px 2px 20px rgba(255,215,0,0.8); }
}


.pookalam-container {
    display: flex;
    justify-content: center;
    margin: 50px 0;
}

.pookalam {
    position: relative;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    animation: slowRotate 60s linear infinite;
}

@keyframes slowRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}


.ring {
    position: absolute;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ring-outer {
    width: 100%;
    height: 100%;
    border: 8px solid #FFD700;
    background: radial-gradient(circle, rgba(255,215,0,0.2), transparent);
    box-shadow: 0 0 30px rgba(255,215,0,0.6);
}

.ring-second {
    width: 85%;
    height: 85%;
    top: 7.5%;
    left: 7.5%;
    background: conic-gradient(from 0deg, #FF6B35, #F7931E, #FF6B35, #F7931E, #FF6B35, #F7931E, #FF6B35, #F7931E);
}

.ring-third {
    width: 65%;
    height: 65%;
    top: 17.5%;
    left: 17.5%;
    background: radial-gradient(circle, #FFD700, #FFA500);
}

.ring-fourth {
    width: 45%;
    height: 45%;
    top: 27.5%;
    left: 27.5%;
    background: radial-gradient(circle, #FFFFFF, #F0F8FF);
}


.flower {
      position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    transform: rotate(var(--rotation)) translateY(-150px);
    animation: flowerPulse 3s ease-in-out infinite;
}

.flower-orange {
    background: radial-gradient(circle, #FF4500, #FF6347);
    box-shadow: 0 0 15px rgba(255,69,0,0.8);
}

@keyframes flowerPulse {
    0%, 100% { transform: rotate(var(--rotation)) translateY(-150px) scale(1); }
    50% { transform: rotate(var(--rotation)) translateY(-150px) scale(1.2); }
}


.petal-pattern {
    position: relative;
    width: 100%;
    height: 100%;
}

.petal {
    position: absolute;
    width: 15px;
    height: 25px;
    background: linear-gradient(45deg, #FFD700, #FFA500);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    top: 50%;
    left: 50%;
    transform-origin: center bottom;
    transform: translate(-50%, -100%) rotate(var(--angle)) translateY(-60px);
    animation: petalSway 4s ease-in-out infinite;
}

@keyframes petalSway {
    0%, 100% { transform: translate(-50%, -100%) rotate(var(--angle)) translateY(-60px); }
    50% { transform: translate(-50%, -100%) rotate(var(--angle)) translateY(-55px) scale(1.1); }
}


.jasmine-pattern {
    position: relative;
    width: 100%;
    height: 100%;
}

.jasmine {
    position: absolute;
    width: 20px;
    height: 20px;
    background: radial-gradient(circle, #FFFFFF, #F0F8FF);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(var(--rotation)) translateY(-70px);
    box-shadow: 0 0 10px rgba(255,255,255,0.8);
    animation: jasmineTwinkle 2s ease-in-out infinite;
}

@keyframes jasmineTwinkle {
    0%, 100% { box-shadow: 0 0 10px rgba(255,255,255,0.8); }
    50% { box-shadow: 0 0 20px rgba(255,255,255,1); }
}


.center-lotus {
    position: absolute;
    width: 25%;
    height: 25%;
    top: 37.5%;
    left: 37.5%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.lotus-petals {
    position: relative;
    width: 100%;
    height: 100%;
}

.lotus-petal {
    position: absolute;
    width: 30px;
    height: 45px;
    background: linear-gradient(45deg, #FFB6C1, #FFC0CB);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    top: 50%;
    left: 50%;
    transform-origin: center bottom;
    transform: translate(-50%, -100%) rotate(var(--rotation)) translateY(-20px);
    animation: lotusBloom 3s ease-in-out infinite;
}

@keyframes lotusBloom {
    0%, 100% { transform: translate(-50%, -100%) rotate(var(--rotation)) translateY(-20px); }
    50% { transform: translate(-50%, -100%) rotate(var(--rotation)) translateY(-25px) scale(1.15); }
}

.lotus-center {
    position: absolute;
    width: 20px;
    height: 20px;
    background: radial-gradient(circle, #FFD700, #FFA500);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 15px rgba(255,215,0,0.9);
    animation: centerGlow 2s ease-in-out infinite alternate;
}

@keyframes centerGlow {
    from { box-shadow: 0 0 15px rgba(255,215,0,0.9); }
    to { box-shadow: 0 0 25px rgba(255,215,0,1); }
}


.decorations {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 600px;
    margin: 0 auto;
    position: relative;
}

.oil-lamp {
    width: 40px;
    height: 60px;
    background: linear-gradient(45deg, #B8860B, #DAA520);
    border-radius: 20px 20px 5px 5px;
    position: relative;
    animation: lampFlicker 1.5s ease-in-out infinite alternate;
}

.oil-lamp::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 15px;
    background: linear-gradient(45deg, #FF4500, #FFD700);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    box-shadow: 0 0 20px rgba(255,69,0,0.8);
}

@keyframes lampFlicker {
    from { transform: scale(1); }
    to { transform: scale(1.05); }
}

.lamp-left {
    animation-delay: 0s;
}

.lamp-right {
    animation-delay: 0.75s;
}


.blessing {
    color: #8B4513;
    font-size: 1.2rem;
    margin-top: 30px;
    font-style: italic;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
}


@media (max-width: 768px) {
    .title {
        font-size: 2rem;
    }

    .pookalam {
        width: 300px;
        height: 300px;
    }

    .decorations {
        width: 400px;
    }

    .blessing {
        font-size: 1rem;
    }
}

@media (max-width: 480px) {
    .title {
        font-size: 1.5rem;
    }

    .pookalam {
        width: 250px;
        height: 250px;
    }

    .decorations {
        width: 300px;
    }
}
